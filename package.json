{
  "name": "agent-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Virtual cards for AI agents, funded with stablecoins, on the Miden Workspace API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:up": "scripts/sandbox-up.sh",
    "dev:keys": "tsx scripts/dev-quickstart.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "swap:rehearse": "tsx scripts/swap-rehearsal.ts",
    "swap:sandbox-e2e": "tsx scripts/swap-sandbox-e2e.ts",
    "swap:live-test": "tsx scripts/swap-live-test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "playwright-core": "1.59.0"
  }
}
