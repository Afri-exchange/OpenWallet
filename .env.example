MIDEN_BASE_URL=https://sandbox-api.midencards.io/miden
MIDEN_TOKEN_URL=https://sandbox-identityserver.midencards.io/connect/token
MIDEN_CLIENT_ID=
MIDEN_CLIENT_SECRET=
MIDEN_UNIQUE_KEY=
# Signature encoding is ambiguous in the Miden docs (see src/miden/signature.ts). Verify against sandbox: base64-of-hex | base64-of-digest
MIDEN_SIGNATURE_MODE=base64-of-hex
