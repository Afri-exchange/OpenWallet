{
  "name": "Agent Card: agent pays over MCP",
  "nodes": [
    {
      "parameters": {},
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Run it",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "o1",
              "name": "baseUrl",
              "value": "http://127.0.0.1:8787",
              "type": "string"
            },
            {
              "id": "o2",
              "name": "amountCents",
              "value": 125,
              "type": "number"
            },
            {
              "id": "o3",
              "name": "description",
              "value": "n8n MCP demo: coffee beans sample",
              "type": "string"
            },
            {
              "id": "o4",
              "name": "reference",
              "value": "={{ 'n8n-' + $now.toMillis() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/merchant/v1/checkouts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ amountCents: $json.amountCents, description: $json.description, reference: $json.reference, idempotencyKey: $json.reference }) }}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Merchant: create checkout",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agentCardsMerchant01",
          "name": "Agent Cards merchant (mk_)"
        }
      }
    },
    {
      "parameters": {
        "endpointUrl": "={{ $('Order').item.json.baseUrl }}/mcp",
        "authentication": "headerAuth",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "get_wallet"
        },
        "inputMode": "json",
        "jsonInput": "{}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Agent (MCP): get_wallet",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agentCardsAgent0001",
          "name": "Agent Cards agent (ak_)"
        }
      }
    },
    {
      "parameters": {
        "endpointUrl": "={{ $('Order').item.json.baseUrl }}/mcp",
        "authentication": "headerAuth",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "pay_checkout"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ checkout_id: $('Merchant: create checkout').item.json.checkoutId, max_amount_usd: $('Order').item.json.amountCents / 100 }) }}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Agent (MCP): pay_checkout",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agentCardsAgent0001",
          "name": "Agent Cards agent (ak_)"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $('Order').item.json.baseUrl }}/merchant/v1/checkouts/{{ $('Merchant: create checkout').item.json.checkoutId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Merchant: confirm payment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agentCardsMerchant01",
          "name": "Agent Cards merchant (mk_)"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "result",
              "value": "={{ $json.status === 'paid' ? 'PAID: fulfil the order' : 'NOT PAID (' + $json.status + ')' }}",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "checkoutId",
              "value": "={{ $json.checkoutId }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "amountCents",
              "value": "={{ $json.amountCents }}",
              "type": "number"
            },
            {
              "id": "r4",
              "name": "paidAt",
              "value": "={{ $json.paidAt }}",
              "type": "string"
            },
            {
              "id": "r5",
              "name": "agentSaid",
              "value": "={{ JSON.stringify($('Agent (MCP): pay_checkout').item.json.content?.[0]?.text) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000007",
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "p1",
              "leftValue": "={{ $json.status === 'processing' && $runIndex < 16 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000020",
      "name": "Still processing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        300
      ],
      "notes": "The card network's answer can be late (the service settles it in the background, usually within a minute). Never fulfil while processing. Gives up after 16 checks (about 4 minutes)."
    },
    {
      "parameters": {
        "amount": 15
      },
      "id": "b1000000-0000-4000-8000-000000000021",
      "name": "Wait 15s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        480
      ],
      "webhookId": "b1000000-0000-4000-8000-000000000022"
    }
  ],
  "connections": {
    "Run it": {
      "main": [
        [
          {
            "node": "Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Order": {
      "main": [
        [
          {
            "node": "Merchant: create checkout",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merchant: create checkout": {
      "main": [
        [
          {
            "node": "Agent (MCP): get_wallet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent (MCP): get_wallet": {
      "main": [
        [
          {
            "node": "Agent (MCP): pay_checkout",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent (MCP): pay_checkout": {
      "main": [
        [
          {
            "node": "Merchant: confirm payment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merchant: confirm payment": {
      "main": [
        [
          {
            "node": "Still processing?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still processing?": {
      "main": [
        [
          {
            "node": "Wait 15s",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 15s": {
      "main": [
        [
          {
            "node": "Merchant: confirm payment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "id": "agentCardsMcpPay01"
}
